{
  "schemaVersion": 1,
  "id": "kudos.span-wallpaper",
  "name": "Horizon",
  "version": "0.3.1",
  "author": "Owain Harris",
  "license": "MIT",
  "description": "Span one image continuously across a selected group of monitors",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Horizon",
    "description": "Open the monitor-spanning wallpaper controls",
    "category": "Compositor",
    "aliases": [
      "wallpaper",
      "background",
      "span"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
